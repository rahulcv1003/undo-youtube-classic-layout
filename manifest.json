{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "short_name": "__MSG_extShortName__",
  "description": "__MSG_extDescription__",
  "version": "0.1.4",
  "default_locale": "en",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "assets/icons/16.png",
    "32": "assets/icons/32.png",
    "48": "assets/icons/48.png",
    "128": "assets/icons/128.png"
  },
  "action": {
    "default_popup": "ui/popup.html",
    "default_title": "__MSG_actionTitle__",
    "default_icon": {
      "16": "assets/icons/16-off.png",
      "32": "assets/icons/32-off.png"
    }
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "permissions": ["storage", "alarms"],
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["sites/youtube/theater-bridge.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["sites/youtube/content.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "commands": {
    "toggle-classic-layout": {
      "suggested_key": { "default": "Alt+Shift+Y" },
      "description": "__MSG_commandToggle__"
    }
  }
}
